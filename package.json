{
  "name": "bigdata-midterm-cbt",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "vitest run",
    "test:browser": "node scripts/browser-check.mjs",
    "validate": "tsx scripts/validate.ts && tsx scripts/validate-final.ts && tsx scripts/validate-notebook.ts",
    "test:final-browser": "node scripts/final-browser-check.mjs",
    "test:handout-browser": "node scripts/handout-browser-check.mjs",
    "test:notebook-browser": "node scripts/notebook-browser-check.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.5",
    "playwright": "^1.62.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
